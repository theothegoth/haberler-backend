const ArticleImage = require('../models/ArticleImage');
const pool = require('../config/database');
const cloudinary = require('../config/cloudinary');
const fs = require('fs').promises;
const { deleteCachePattern, deleteCache } = require('../config/cache');

// Add a new image to an article
const addArticleImage = async (req, res) => {
  try {
    const userId = req.user?.id || req.user?.userId;
    const { articleId } = req.params;
    const { caption } = req.body;

    if (!userId) {
      return res.status(401).json({ error: 'Authentication required' });
    }

    // Verify article exists and belongs to user (check drafts first, then user_news)
    let articleResult = await pool.query(
      'SELECT id, user_id FROM drafts WHERE id = $1',
      [articleId]
    );

    // If not found in drafts, check user_news table
    if (articleResult.rows.length === 0) {
      articleResult = await pool.query(
        'SELECT id, user_id FROM user_news WHERE id = $1',
        [articleId]
      );
    }

    if (articleResult.rows.length === 0) {
      return res.status(404).json({ error: 'Article not found' });
    }

    if (articleResult.rows[0].user_id !== userId) {
      return res.status(403).json({ error: 'You do not have permission to add images to this article' });
    }

    // Check if file was uploaded
    if (!req.file) {
      return res.status(400).json({ error: 'No image file provided' });
    }

    // Check if article already has 5 images (maximum limit)
    const imageCountResult = await pool.query(
      'SELECT COUNT(*) FROM article_images WHERE article_id = $1',
      [articleId]
    );
    const imageCount = parseInt(imageCountResult.rows[0].count);

    if (imageCount >= 5) {
      // Delete the uploaded file since we won't use it
      try {
        await fs.unlink(req.file.path);
      } catch (unlinkError) {
        // File already deleted or doesn't exist
      }
      return res.status(400).json({ error: 'Maximum 5 images allowed per article' });
    }

    // Upload to Cloudinary
    const result = await cloudinary.uploader.upload(req.file.path, {
      folder: 'article-gallery',
      transformation: [
        { width: 1200, height: 800, crop: 'limit' },
        { quality: 'auto' }
      ]
    });

    // Delete local file
    await fs.unlink(req.file.path);

    // Get next display order
    const nextOrder = await ArticleImage.getNextDisplayOrder(articleId);

    // Save image record to database
    const image = await ArticleImage.addImage(
      articleId,
      result.secure_url,
      caption || null,
      nextOrder
    );

 // Invalidate caches for this article and user's articles list
    deleteCache(`article:${articleId}`).catch(err => console.error('Cache invalidation error:', err));
    deleteCachePattern(`user:${userId}:articles:*`).catch(err => console.error('Cache invalidation error:', err));
    deleteCachePattern('news:feed:*').catch(err => console.error('Cache invalidation error:', err));   

     res.status(201).json({
      message: 'Image added successfully',
      image
    });
  } catch (error) {
    console.error('[IMAGE_UPLOAD] Error:', error);
    console.error('[IMAGE_UPLOAD] Stack:', error.stack);
    // Clean up file if it exists
    if (req.file?.path) {
      try {
        await fs.unlink(req.file.path);
      } catch (unlinkError) {
        // File already deleted or doesn't exist
      }
    }
    res.status(500).json({ error: 'Failed to add image' });
  }
};

// Get all images for an article
const getArticleImages = async (req, res) => {
  try {
    const { articleId } = req.params;

    // Verify article exists (check both user_news and drafts)
    let articleResult = await pool.query(
      'SELECT id FROM user_news WHERE id = $1',
      [articleId]
    );

    // If not found in user_news, check drafts table
    if (articleResult.rows.length === 0) {
      articleResult = await pool.query(
        'SELECT id FROM drafts WHERE id = $1',
        [articleId]
      );
    }

    if (articleResult.rows.length === 0) {
      return res.status(404).json({ error: 'Article not found' });
    }

    const images = await ArticleImage.getArticleImages(articleId);

    res.json({ images });
  } catch (error) {
    console.error('[GET_ARTICLE_IMAGES] Error:', error);
    console.error('[GET_ARTICLE_IMAGES] Stack:', error.stack);
    res.status(500).json({ error: 'Failed to get article images' });
  }
};

// Update image caption
const updateImageCaption = async (req, res) => {
  try {
    const userId = req.user?.id || req.user?.userId;
    const { imageId } = req.params;
    const { caption } = req.body;

    if (!userId) {
      return res.status(401).json({ error: 'Authentication required' });
    }

    // Get image and verify ownership
    const image = await ArticleImage.getImageById(imageId);

    if (!image) {
      return res.status(404).json({ error: 'Image not found' });
    }

    // Check if user owns the article (check drafts first, then user_news)
    let articleResult = await pool.query(
      'SELECT user_id FROM drafts WHERE id = $1',
      [image.article_id]
    );

    // If not found in drafts, check user_news table
    if (articleResult.rows.length === 0) {
      articleResult = await pool.query(
        'SELECT user_id FROM user_news WHERE id = $1',
        [image.article_id]
      );
    }

    if (articleResult.rows.length === 0 || articleResult.rows[0].user_id !== userId) {
      return res.status(403).json({ error: 'You do not have permission to update this image' });
    }

    const updatedImage = await ArticleImage.updateCaption(imageId, caption);

 // Invalidate caches for this article
    deleteCache(`article:${image.article_id}`).catch(err => console.error('Cache invalidation error:', err));

    res.json({
      message: 'Caption updated successfully',
      image: updatedImage
    });
  } catch (error) {
    console.error('[CAPTION_UPDATE] Error:', error);
    res.status(500).json({ error: 'Failed to update caption' });
  }
};

// Delete an image
const deleteArticleImage = async (req, res) => {
  try {
    const userId = req.user?.id || req.user?.userId;
    const { imageId } = req.params;

    if (!userId) {
      return res.status(401).json({ error: 'Authentication required' });
    }

    // Get image and verify ownership
    const image = await ArticleImage.getImageById(imageId);

    if (!image) {
      return res.status(404).json({ error: 'Image not found' });
    }

    // Check if user owns the article (check drafts first, then user_news)
    let articleResult = await pool.query(
      'SELECT user_id FROM drafts WHERE id = $1',
      [image.article_id]
    );

    // If not found in drafts, check user_news table
    if (articleResult.rows.length === 0) {
      articleResult = await pool.query(
        'SELECT user_id FROM user_news WHERE id = $1',
        [image.article_id]
      );
    }

    if (articleResult.rows.length === 0 || articleResult.rows[0].user_id !== userId) {
      return res.status(403).json({ error: 'You do not have permission to delete this image' });
    }

    // Delete from Cloudinary
    try {
      const publicId = image.image_url.split('/').slice(-2).join('/').split('.')[0];
      await cloudinary.uploader.destroy(publicId);
    } catch (cloudinaryError) {
      // Continue even if Cloudinary deletion fails
    }

    // Delete from database
    await ArticleImage.deleteImage(imageId);

 // Invalidate caches for this article and user's articles list
    deleteCache(`article:${image.article_id}`).catch(err => console.error('Cache invalidation error:', err));
    deleteCachePattern(`user:${userId}:articles:*`).catch(err => console.error('Cache invalidation error:', err));
    deleteCachePattern('news:feed:*').catch(err => console.error('Cache invalidation error:', err));

    res.json({ message: 'Image deleted successfully' });
  } catch (error) {
    res.status(500).json({ error: 'Failed to delete image' });
  }
};

// Reorder images
const reorderImages = async (req, res) => {
  try {
    const userId = req.user?.id || req.user?.userId;
    const { articleId } = req.params;
    const { imageOrders } = req.body;

    if (!userId) {
      return res.status(401).json({ error: 'Authentication required' });
    }

    // Verify article exists and belongs to user (check drafts first, then user_news)
    let articleResult = await pool.query(
      'SELECT user_id FROM drafts WHERE id = $1',
      [articleId]
    );

    // If not found in drafts, check user_news table
    if (articleResult.rows.length === 0) {
      articleResult = await pool.query(
        'SELECT user_id FROM user_news WHERE id = $1',
        [articleId]
      );
    }

    if (articleResult.rows.length === 0) {
      return res.status(404).json({ error: 'Article not found' });
    }

    if (articleResult.rows[0].user_id !== userId) {
      return res.status(403).json({ error: 'You do not have permission to reorder images for this article' });
    }

    // Validate imageOrders format
    if (!Array.isArray(imageOrders) || imageOrders.length === 0) {
      return res.status(400).json({ error: 'Invalid image orders format' });
    }

    // Verify all images belong to this article
    for (const { id } of imageOrders) {
      const image = await ArticleImage.getImageById(id);
      if (!image || image.article_id !== parseInt(articleId)) {
        return res.status(400).json({ error: 'Invalid image ID in order list' });
      }
    }

    await ArticleImage.reorderImages(imageOrders);

    res.json({ message: 'Images reordered successfully' });
  } catch (error) {
    res.status(500).json({ error: 'Failed to reorder images' });
  }
};

module.exports = {
  addArticleImage,
  getArticleImages,
  updateImageCaption,
  deleteArticleImage,
  reorderImages
};
